<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net472</TargetFramework>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Reference assemblies. Defaults to the repo-local lib/ (gitignored); override with
       VALHEIM_INSTALL to build straight against a game install. -->
  <PropertyGroup>
    <LibDir>$(MSBuildThisFileDirectory)lib</LibDir>
    <ValheimManaged Condition="'$(VALHEIM_INSTALL)' != ''">$(VALHEIM_INSTALL)/valheim_Data/Managed</ValheimManaged>
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">$(LibDir)</ValheimManaged>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(LibDir)</BepInExPath>
  </PropertyGroup>
</Project>
